# 统一行尾：文本文件在仓库中统一为 LF
* text=auto eol=lf

# 明确指定常见文本类型
*.py     text eol=lf
*.ipynb  text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml  text eol=lf
*.json   text eol=lf

# 二进制文件不做行尾转换
*.pth    binary
*.pt     binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.pdf    binary
